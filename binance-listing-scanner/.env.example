# --- Data sources ---
# Dune Sim API key (free signup at https://sim.dune.com) — covers EVM + Solana
DUNE_SIM_API_KEY=

# Etherscan multichain V2 API key (one key, all EVM chains)
ETHERSCAN_API_KEY=

# Helius (Solana indexer) — free tier OK
HELIUS_API_KEY=

# CoinGecko API key (free Demo plan works)
COINGECKO_API_KEY=

# --- Telegram scraper (Telethon, USER account) ---
# Create at https://my.telegram.org → API Development Tools
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=binance_alpha_scraper
# Comma-separated public channel usernames (no @). e.g. cryptolisting,binancealphacalls
TG_CHANNELS=

# --- Scanner config ---
LOOKBACK_LISTINGS=20         # how many recent Binance memecoin listings to backfill
PRE_LISTING_WINDOW_HOURS=72  # buyers in this window are "pre-listing" candidates
MIN_LISTINGS_FOR_INSIDER=3   # wallet must appear in >= N listings to be flagged
DB_PATH=./data/scanner.db
