# Hyperliquid (no key needed for public market data)
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# Venues to ingest (comma-separated; valid: hyperliquid, binance)
# Note: binance is geo-restricted from US IPs — run from fly.io nrt/fra.
INGEST_VENUES=hyperliquid,binance

# Symbols to ingest (comma-separated)
INGEST_SYMBOLS=BTC,ETH,SOL

# DuckDB file location (relative to repo root)
DUCKDB_PATH=./data/perps.duckdb

# Web app talks to the same DuckDB file by default.
# Override if running ingest and web on different machines / volumes.

# Optional macro/news.
# CRYPTOPANIC_TOKEN — get a free token at https://cryptopanic.com/developers
# (api.cryptopanic.com/v1/posts/?auth_token=...). Leave empty to skip news polling.
CRYPTOPANIC_TOKEN=

# Disable the macro fetchers entirely (e.g. CI smoke tests):
# PERPS_DISABLE_MACRO=1
