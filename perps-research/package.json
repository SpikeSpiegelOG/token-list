{
  "name": "perps-research",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter='./packages/**' build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @perps/web dev",
    "dev:web": "pnpm --filter @perps/web dev",
    "dev:ingest-standalone": "pnpm --filter @perps/ingest dev",
    "start": "pnpm --filter @perps/web start"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
